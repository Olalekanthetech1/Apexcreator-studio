# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# BYBIT_API_KEY: Optional default Bybit Read-Only API Key
BYBIT_API_KEY=""

# BYBIT_API_SECRET: Optional default Bybit Read-Only API Secret
BYBIT_API_SECRET=""

# DATABASE_URL: PostgreSQL Connection String from Neon (e.g. postgresql://user:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require)
DATABASE_URL=""

# PAYSTACK_PUBLIC_KEY: Paystack Public Key (e.g. pk_live_... or pk_test_...)
PAYSTACK_PUBLIC_KEY=""

# PAYSTACK_SECRET_KEY: Paystack Secret Key (e.g. sk_live_... or sk_test_...)
PAYSTACK_SECRET_KEY=""

# Optional: Automated deployment token (for headless rules/indexes publishing)
FIREBASE_TOKEN=""
